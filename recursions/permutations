class Solution {
public:
    vector<vector<int>> permute(vector<int>& s) {
        vector<vector<int>> result;
        vector<int> path;
        vector<bool> used(s.size(), false);
        function<void()> backtrack = [&]() {
            if (path.size() == s.size()) {
                result.push_back(path);
                return;
            }
            for (int i = 0; i < s.size(); i++) {
                if (used[i]) continue;
                if (i > 0 && s[i] == s[i - 1] && !used[i - 1]) continue;
                used[i] = true;
                path.push_back(s[i]);
                backtrack();
                path.pop_back();
                used[i] = false;
            }
        };
        backtrack();
        return result;
    }
};
