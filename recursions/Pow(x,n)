class Solution {
public:
    double myPow(double x, int n) {
        long long nums = n;
        if(nums<0){
            x=1/x;
            nums = -1 * nums;
        }
        if(nums==0) return 1;
        if(nums==1) return x;
        if(nums%2==1){
            return x * myPow(x,nums-1);
        }
        return myPow(x*x,nums/2);
    }
};
