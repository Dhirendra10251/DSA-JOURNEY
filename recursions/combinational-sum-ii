class Solution {
private:
    void func(int ind, int target , vector<int>& arr,vector<int>& nums,vector<vector<int>>& ans){
        if(target == 0){
            ans.push_back(arr);
            return;
        }
        if(target<0 || ind == nums.size()) return;
        arr.push_back(nums[ind]);
        func(ind+1,target - nums[ind],arr,nums,ans);
        arr.pop_back();
        for(int i = ind+1;i<nums.size();i++){
            if(nums[i] != nums[ind]){
                func(i,target,arr,nums,ans);
                break;
            }
        }
    }
public:
    vector<vector<int>> combinationSum2(vector<int>& nums, int target) {
        vector<vector<int>> ans;
        vector<int> arr;
        sort(nums.begin(),nums.end());
        func(0,target,arr,nums,ans);
        return ans;
    }
};
