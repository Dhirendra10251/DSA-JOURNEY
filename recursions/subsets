class Solution {
private:
    void func(int ind,vector<int>& arr,vector<int>& nums,vector<vector<int>>& ans){
        if(ind == nums.size()){
            ans.push_back(arr);
            return;
        }   
        func(ind+1,arr,nums,ans);
        arr.push_back(nums[ind]);
        func(ind+1,arr,nums,ans);
        arr.pop_back();           
    }
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> arr;
        func(0,arr,nums,ans);
        return ans;
    }
};
