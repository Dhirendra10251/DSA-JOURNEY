class Solution {
  public:
    long subarrayXor(vector<int> &nums, int k) {
        int n = nums.size();
        int xr = 0;
        map<int,int> mpp;
        mpp[xr]++;
        int cnt  = 0;
        for(int i = 0; i<n; i++){
            xr ^= nums[i];
            int x = xr ^ k ;
            cnt += mpp[x];
            mpp[xr]++;
        }
        return cnt;
    }
};
