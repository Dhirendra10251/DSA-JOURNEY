class Solution {
public:
    int maxScore(vector<int>& cardPoints, int k) {
        int r = cardPoints.size()-1;
        int currentSum = 0;
        int maxSum = 0;
        for(int i = 0;i<k;i++){
            currentSum += cardPoints[i];
        }
        maxSum = currentSum;
        for(int i = k-1;i>=0;i--){
            currentSum -= cardPoints[i];
            currentSum += cardPoints[r];
            r--;
            maxSum = max(maxSum,currentSum);
        }
        return maxSum;
    }
};
