class Solution {
public:
    vector<int> leaders(vector<int>& nums) {
        int maxi = INT_MIN;
        vector<int> leaders;
        for(int i =nums.size()-1;i>=0;i--){
            if(nums[i]>maxi){
                leaders.push_back(nums[i]);
            }
            maxi = max(maxi,nums[i]);
        }
        reverse(leaders.begin(), leaders.end());
        return leaders;
    }
};
