/*
Definition of singly linked list:
struct ListNode
{
    int val;
    ListNode *next;
    ListNode()
    {
        val = 0;
        next = NULL;
    }
    ListNode(int data1)
    {
        val = data1;
        next = NULL;
    }
    ListNode(int data1, ListNode *next1)
    {
        val = data1;
        next = next1;
    }
};
*/

class Solution {
private:
    ListNode* reverseLL(ListNode* head){
        ListNode* temp = head;
        ListNode* prev = NULL;
        while(temp != NULL){
            ListNode* front = temp->next;
            temp->next = prev;
            prev = temp;
            temp = front;
        }
        return prev;
    }
    ListNode* findKth(ListNode* temp,int k){
        k-=1;
        while(temp != NULL && k>0){
            k--;
            temp = temp->next;
        }
        return temp;
    }
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        ListNode* temp =head;
        ListNode* prevlast = NULL;
        while(temp!=NULL){
            ListNode* kthnode =  findKth(temp , k);
            if(kthnode == NULL){
                if(prevlast){
                    prevlast->next = temp;
                }
                break;
            }
            ListNode* next = kthnode->next;
            kthnode->next =NULL;
            reverseLL(temp);
            if(temp == head){
                head = kthnode;
            }else{
                prevlast->next = kthnode;
            }
            prevlast = temp;
            temp = next;
        }
        return head;
    }
};
